{
  "name": "github_profile",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fetch:github": "node scripts/fetch-github.mjs",
    "fetch:pubs": "node scripts/fetch-publications.mjs",
