    "screenshots": "node scripts/screenshots.mjs",
    "covers:optimise": "node scripts/optimise-covers.mjs",
    "cv:pdf": "quarto typst compile --root . scripts/cv.typ public/cv.pdf",
    "og": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.131",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "astro-icon": "^1.2.0",
    "js-yaml": "^5.4.1",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-yaml": "^4.0.9",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4"
  }
