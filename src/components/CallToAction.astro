---
// Soft offer shown under tools and courses: support, on-demand teaching, collaboration.
import { profile } from '../lib/data';
import ButtonLink from './ButtonLink.astro';

interface Props {
  kind: 'tool' | 'course' | 'tools-list' | 'courses-list' | 'projects-list';
  name?: string;
  question?: string;
  detail?: string;
}
const { kind, name = '', question, detail } = Astro.props;
const [emailUser, emailDomain] = profile.socials.email.split('@');

const copy = {
  tool: {
    title: question ?? `Using ${name} in your study?`,
    body: detail ?? 'I can help you apply it to your cohort, adapt the indices to your data, or set up a reproducible pipeline around it.',
    button: 'Get in touch',
    subject: `${name}: support request`
  },
  course: {
    title: 'Run this course for your group',
    body: `I teach ${name} on demand for research groups, departments and companies, on site or online, adapted to your data and level.`,
    button: 'Ask about a session',
    subject: `${name}: course request`
  },
  'tools-list': {
    title: 'Need help applying these tools to your data?',
    body: 'Support, custom extensions and collaboration are available for each package.',
    button: 'Get in touch',
    subject: 'Research tools: support request'
  },
  'projects-list': {
    title: 'Interested in any of these projects?',
    body: 'I am open to collaboration on shared genetics, polygenic scores and biomarker studies.',
    button: 'Email me',
    subject: 'Project enquiry'
  },
  'courses-list': {
    title: 'All courses can be run on demand',
    body: 'For research groups, departments and companies, on site or online, adapted to your data and level.',
    button: 'Ask about a session',
    subject: 'Course request'
  }
}[kind];
---

<div class="cta mt-12 rounded-2xl border border-accent/30 bg-accent/5 px-6 py-6 sm:flex sm:items-center sm:justify-between sm:gap-8 dark:border-accent/40 dark:bg-accent/10">
  <div>
    <p class="font-semibold text-primary dark:text-white">{copy.title}</p>
    <p class="mt-1 text-sm text-muted">{copy.body}</p>
  </div>
  <div class="mt-4 shrink-0 sm:mt-0">
    <a
      href="/contact/"
      class="cta-mail inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-white transition hover:bg-primary-light dark:bg-white dark:text-primary dark:hover:bg-slate-200"
      data-user={emailUser}
      data-domain={emailDomain}
      data-subject={copy.subject}
    >{copy.button}</a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a.cta-mail').forEach((a) => {
    const { user, domain, subject } = a.dataset;
    if (user && domain) a.href = `mailto:${user}@${domain}?subject=${encodeURIComponent(subject ?? '')}`;
  });
</script>
