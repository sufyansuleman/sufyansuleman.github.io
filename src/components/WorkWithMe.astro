---
// "How I can help" strip, reused on the Home page and (compact) on the Contact page.
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';
import { profile } from '../lib/data';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const [emailUser, emailDomain] = profile.socials.email.split('@');

const columns = [
  {
    icon: 'lucide:wrench',
    title: 'Support with the tools',
    body: 'Applying HealthMarkers, InsuSensCalc or IsletCalc to your cohort, adapting indices, or building a reproducible pipeline around them.',
    linkText: 'Ask about support',
    subject: 'Tool support request'
  },
  {
    icon: 'lucide:graduation-cap',
    title: 'Courses on demand',
    body: 'R, statistics, CDISC and post-GWAS methods for research groups, departments and companies, on site or online.',
    linkText: 'Ask about a course',
    subject: 'Course request'
  },
  {
    icon: 'lucide:users',
    title: 'Research collaboration',
    body: 'Genetics of metabolic and psychiatric traits, polygenic scores, biomarker studies.',
    linkText: 'Propose a collaboration',
    subject: 'Collaboration'
  }
];
---

<div>
  {!compact && (
    <SectionHeader eyebrow="Work with me" title="How I can help" />
  )}
  <div class:list={['grid gap-8 sm:grid-cols-3', compact ? 'mt-4' : 'mt-10']}>
    {columns.map((col) => (
      <div>
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent/10 text-accent">
          <Icon name={col.icon} class="h-5 w-5" />
        </div>
        <p class="mt-3 font-semibold text-primary dark:text-white">{col.title}</p>
        <p class="mt-1 text-sm text-muted">{col.body}</p>
        <a
          href="#"
          class="js-mailto mt-2 inline-block text-sm text-accent hover:text-accent-hover"
          data-user={emailUser}
          data-domain={emailDomain}
          data-subject={col.subject}
        >{col.linkText}</a>
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a.js-mailto:not([data-bound])').forEach((a) => {
    a.dataset.bound = 'true';
    const { user, domain, subject } = a.dataset;
    if (user && domain) a.href = `mailto:${user}@${domain}?subject=${encodeURIComponent(subject ?? '')}`;
  });
</script>
