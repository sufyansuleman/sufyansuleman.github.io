---
import { profile } from '../lib/data';

interface Props {
  headline: string;
  subheadline?: string;
  lead?: string;
  paragraphs?: string[];
  kicker?: string;
}

const { headline, subheadline, kicker, lead, paragraphs = [] } = Astro.props;
const [emailUser, emailDomain] = profile.socials.email.split('@');
---

<section class="bg-gradient-to-b from-surface to-white dark:from-[#111A2E] dark:to-[#0B1220]">
  <div class="container-x grid gap-10 py-12 lg:grid-cols-[1.3fr_1fr] lg:items-center lg:py-16">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight text-primary dark:text-white sm:text-4xl lg:text-5xl">
        {headline}
      </h1>
      {kicker && <p class="mt-3 text-lg font-medium text-accent sm:text-xl">{kicker}</p>}
      {lead && <p class="mt-6 text-xl font-semibold text-ink dark:text-white">{lead}</p>}
      {paragraphs.map((t, i) => (
        <p class="mt-5 max-w-xl text-base text-muted first:mt-6">{t}</p>
      ))}
      {subheadline && <p class="mt-4 max-w-xl text-base text-muted">{subheadline}</p>}
      <div class="mt-6 flex flex-wrap gap-3">
        <slot name="actions" />
      </div>
      <p class="mt-4 text-sm text-muted">
        Open to collaborations, tool support and teaching requests.{' '}
        <a
          href="#"
          class="js-mailto text-accent hover:text-accent-hover"
          data-user={emailUser}
          data-domain={emailDomain}
          data-subject="Hello from your website"
        >Email me</a>
      </p>
    </div>

    <div>
      <slot name="aside" />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a.js-mailto:not([data-bound])').forEach((a) => {
    a.dataset.bound = 'true';
    const { user, domain, subject } = a.dataset;
    if (user && domain) a.href = `mailto:${user}@${domain}?subject=${encodeURIComponent(subject ?? '')}`;
  });
</script>
