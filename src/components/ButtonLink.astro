---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  icon?: string;
  external?: boolean;
}

const { href, variant = 'primary', icon, external = false } = Astro.props;

const variants: Record<string, string> = {
  primary: 'bg-primary text-white hover:bg-primary-light dark:bg-white dark:text-primary dark:hover:bg-slate-200',
  secondary: 'border border-line text-ink hover:bg-surface dark:text-[#E5EAF2] dark:border-[#233049] dark:hover:bg-[#111A2E]',
  ghost: 'text-accent hover:text-accent-hover'
};

const base =
  variant === 'ghost'
    ? 'inline-flex items-center gap-1.5 text-sm font-medium'
    : 'inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition-colors';
---

<a
  href={href}
  class:list={[base, variants[variant]]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  {icon && <Icon name={icon} class="h-4 w-4" />}
  <slot />
  {variant === 'ghost' && <Icon name="lucide:arrow-right" class="h-4 w-4" />}
</a>
