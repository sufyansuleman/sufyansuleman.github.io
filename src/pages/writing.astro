---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import MailLine from '../components/MailLine.astro';
import { getCollection } from 'astro:content';

const allEssays = await getCollection('essays', (entry) => entry.data.status !== 'draft');
const essays = allEssays.sort((a, b) => b.data.date.localeCompare(a.data.date));

function monthYear(date: string) {
  return new Date(`${date}-01`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
}
---

<Base title="Writing">
  <section class="container-x py-20">
    <SectionHeader
      title="Writing"
      lede="Writing is a hobby of mine, not part of my research position."
    />

    <div class="mt-6 max-w-3xl space-y-4 text-base leading-relaxed text-ink dark:text-[#E5EAF2]">
      <p>Traditional medicine has interested me for a long time, in particular how older systems classified people before treating them and whether anything in those classifications corresponds to variation we can now measure. That interest led to a book in Urdu and one in Persian, and to an essay in English where I try to hold the question to the evidence.</p>
    </div>

    <h2 class="mt-12 text-2xl font-semibold tracking-tight text-primary dark:text-white sm:text-3xl">Essays</h2>
    <div class="mt-6 max-w-3xl divide-y divide-line dark:divide-[#233049]">
      {essays.length === 0 && <p class="py-6 text-sm text-muted">First essay coming soon.</p>}
      {essays.map((entry) => (
        <article class="py-6 first:pt-0">
          <h3 class="text-lg font-semibold text-primary dark:text-white">
            <a href={`/essays/${entry.id}/`} class="hover:text-accent">{entry.data.title}</a>
            {entry.data.status === 'living' && (
              <span class="ml-2 inline-flex items-center rounded-full border border-line px-2 py-0.5 align-middle text-xs font-medium text-ink dark:border-[#233049] dark:text-[#E5EAF2]">Living essay</span>
            )}
          </h3>
          {entry.data.summary && <p class="mt-2 text-sm text-muted">{entry.data.summary}</p>}
          <p class="mt-2 text-xs text-muted">{monthYear(entry.data.date)}</p>
        </article>
      ))}
    </div>

    <h2 class="mt-16 text-2xl font-semibold tracking-tight text-primary dark:text-white sm:text-3xl">Books</h2>
    <div class="mt-6 grid max-w-3xl gap-6 sm:grid-cols-2">
      <a href="/books/mizaj-shanasi/" class="group rounded-2xl border border-line bg-white p-6 transition hover:border-accent dark:border-[#233049] dark:bg-[#111A2E]">
        <p class="text-xs font-semibold uppercase tracking-wide text-accent">Urdu</p>
        <p class="mt-2 text-lg font-semibold text-primary group-hover:text-accent dark:text-white" lang="ur" dir="rtl">مزاج شناسی</p>
        <p class="mt-1 font-medium text-ink dark:text-[#E5EAF2]">Mizaj Shanasi</p>
        <p class="mt-3 text-sm text-muted">My Urdu translation of Ustad Taleqani's Persian work on temperament in traditional medicine, translated with the author's permission. Nine chapters, complete and readable here.</p>
        <p class="mt-4 text-sm font-medium text-accent">Read the book</p>
      </a>
      <div class="rounded-2xl border border-line bg-white p-6 dark:border-[#233049] dark:bg-[#111A2E]">
        <p class="text-xs font-semibold uppercase tracking-wide text-accent">Persian</p>
        <p class="mt-2 font-semibold text-primary dark:text-white">In progress</p>
        <p class="mt-3 text-sm text-muted">Chapters will appear here as they are finished.</p>
      </div>
    </div>

    <div class="mt-12 max-w-3xl">
      <MailLine text="Want to discuss any of this?" subject="Writing" />
    </div>
  </section>
</Base>
