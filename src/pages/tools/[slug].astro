---
import CallToAction from '../../components/CallToAction.astro';
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import Badge from '../../components/Badge.astro';
import Cover from '../../components/Cover.astro';
import { Icon } from 'astro-icon/components';
import { getItems } from '../../lib/catalog';
import { getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  return getItems('tool').map((item) => ({ params: { slug: item.urlSlug }, props: { item } }));
}

const { item } = Astro.props;
const entry = await getEntry('tools', item.urlSlug);
const { Content } = entry ? await render(entry) : { Content: null };

const screenshot = existsSync(new URL(`../../../public/screenshots/${item.slug}.jpg`, import.meta.url))
  ? `/screenshots/${item.slug}.jpg`
  : undefined;

const banner = existsSync(new URL(`../../../public/covers/${item.slug}.jpg`, import.meta.url))
  ? `/covers/${item.slug}.jpg`
  : undefined;

const updated = item.updated
  ? new Date(item.updated).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })
  : undefined;
---

<Base title={item.title} description={item.tagline}>
  <section class="container-x py-12">
    <nav class="text-sm text-muted">
      <a href="/tools/" class="hover:text-accent">Research Tools</a>
      <span class="mx-2">/</span>
      <span class="text-ink dark:text-white">{item.title}</span>
    </nav>

    <div class="mt-6 flex flex-wrap items-center gap-6">
      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-primary to-accent">
        <Icon name={item.icon} class="h-8 w-8 text-white" />
      </div>
      <div class="flex-1">
        <h1 class="text-3xl font-semibold tracking-tight text-primary dark:text-white sm:text-4xl">{item.title}</h1>
        <p class="mt-2 max-w-2xl text-lg text-muted">{item.tagline}</p>
        {item.manual?.note && <p class="mt-1 max-w-2xl text-sm text-muted">{item.manual.note}</p>}
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      {item.links.launch && <ButtonLink href={item.links.launch} icon="lucide:external-link" external>Launch browser</ButtonLink>}
      {item.links.docs && <ButtonLink href={item.links.docs} icon="lucide:book-open" external>Documentation</ButtonLink>}
      {item.links.github && (
        <ButtonLink href={item.links.github} variant="secondary" icon="lucide:github" external>
          Source on GitHub
        </ButtonLink>
      )}
      {item.links.doi && (
        <ButtonLink href={item.links.doi} variant="ghost" icon="lucide:quote" external>
          Cite
        </ButtonLink>
      )}
    </div>

    <figure class="mt-10">
      {banner ? (
        <img
          width="1600"
          height="900"
          src={banner}
          alt={`${item.title} cover`}
          loading="lazy"
          class="w-full rounded-2xl border border-line dark:border-[#233049]"
        />
      ) : (
        <Cover item={item} variant="full" class="w-full rounded-2xl border border-line dark:border-[#233049]" />
      )}
    </figure>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_320px]">
      <div class="prose prose-slate dark:prose-invert max-w-none min-w-0 break-words prose-headings:text-primary dark:prose-headings:text-white prose-h2:mt-10 prose-h2:text-xl prose-a:text-accent prose-pre:rounded-xl prose-pre:overflow-x-auto prose-code:before:content-none prose-code:after:content-none">
        {Content && <Content />}

      </div>

      <aside class="h-fit rounded-2xl border border-line bg-white p-6 dark:bg-[#111A2E] dark:border-[#233049] lg:sticky lg:top-24">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">At a glance</h2>
        <dl class="mt-4 space-y-3 text-sm">
          {(item.repo?.language ?? item.manual?.language) && (
            <div class="flex justify-between gap-4">
              <dt class="text-muted">Language</dt>
              <dd class="font-medium text-ink dark:text-white">{item.repo?.language ?? item.manual?.language}</dd>
            </div>
          )}
          {updated && (
            <div class="flex justify-between gap-4">
              <dt class="text-muted">Last updated</dt>
              <dd class="font-medium text-ink dark:text-white">{updated}</dd>
            </div>
          )}
        </dl>

        {item.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {item.tags.map((tag) => <Badge>{tag}</Badge>)}
          </div>
        )}

        {item.links.doi && (
          <div class="mt-6 rounded-xl bg-surface p-4 dark:bg-[#0B1220]">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">Cite this</p>
            <a href={item.links.doi} target="_blank" rel="noopener noreferrer" class="mt-1 block break-all text-sm text-accent hover:text-accent-hover">
              {item.links.doi}
            </a>
          </div>
        )}

        {screenshot && (item.links.site ?? item.links.docs) && (
          <a href={item.links.site ?? item.links.docs} target="_blank" rel="noopener noreferrer" class="mt-6 block max-w-[320px]">
            <img
              width="1440"
              height="900"
              src={screenshot}
              alt={`${item.title} documentation site screenshot`}
              loading="lazy"
              class="w-full rounded-xl border border-line dark:border-[#233049]"
            />
            <p class="mt-2 text-xs text-muted">Documentation site</p>
          </a>
        )}
      </aside>
    </div>
    <CallToAction kind="tool" name={item.title} question={item.cta?.question} detail={item.cta?.detail} />
  </section>
</Base>
