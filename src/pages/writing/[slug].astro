---
import Article from '../../layouts/Article.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('writing', (entry) => entry.data.status !== 'draft');
  return essays.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const updated = entry.data.updated
  ? new Date(`${entry.data.updated}-01`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })
  : undefined;
---

<Article
  title={entry.data.title}
  summary={entry.data.summary}
  updated={updated}
  statusLabel={entry.data.status === 'living' ? 'Living essay' : undefined}
  crumbs={[{ label: 'Writing', href: '/writing/' }, { label: entry.data.title }]}
  headings={headings}
  mailText="If any of this overlaps with your work, I would like to hear from you."
  mailSubject={entry.data.title}
>
  <Content />
</Article>
