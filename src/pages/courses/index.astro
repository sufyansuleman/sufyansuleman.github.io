---
import CallToAction from '../../components/CallToAction.astro';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import Cover from '../../components/Cover.astro';
import { getItems } from '../../lib/catalog';

const courses = getItems('course');

function metaLine(course: NonNullable<(typeof courses)[number]['course']>): string {
  return [course.level, course.duration && course.duration !== 'TBC' ? course.duration : undefined, course.audience]
    .filter(Boolean)
    .join(' · ');
}
---

<Base title="Courses">
  <section class="container-x py-20">
    <SectionHeader
      title="Courses"
      lede="Self-paced courses for researchers and statistical programmers."
    />
    <div class="mt-10 space-y-6">
      {courses.map((item) => {
        return (
        <div class="flex flex-col gap-6 rounded-2xl border border-line bg-white p-6 dark:bg-[#111A2E] dark:border-[#233049] sm:flex-row sm:items-center">
          <div class="aspect-video w-[200px] shrink-0 overflow-hidden rounded-xl border border-line dark:border-[#233049]">
            <Cover item={item} />
          </div>
          <div class="flex-1">
            <a href={`/courses/${item.urlSlug}/`} class="text-lg font-semibold text-primary hover:text-accent dark:text-white">{item.title}</a>
            <p class="mt-1 text-sm text-muted">{item.tagline}</p>
            {item.course && (
              <p class="mt-3 text-xs font-medium uppercase tracking-wide text-muted">
                {metaLine(item.course)}
              </p>
            )}
          </div>
          <div class="flex flex-wrap gap-3 sm:w-64 sm:shrink-0 sm:justify-start">
            {item.links.site && <ButtonLink href={item.links.site} variant="secondary" external>Course website</ButtonLink>}
            {item.links.slides && item.links.slides !== item.links.site && (
              <ButtonLink href={item.links.slides} variant="secondary" external>Slides</ButtonLink>
            )}
            {item.links.github && <ButtonLink href={item.links.github} variant="ghost" icon="lucide:github" external>Source</ButtonLink>}
          </div>
        </div>
        );
      })}
    </div>
    <CallToAction kind="courses-list" />
  </section>
</Base>
