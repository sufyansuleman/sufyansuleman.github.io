---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Badge from '../components/Badge.astro';
import ButtonLink from '../components/ButtonLink.astro';
import Timeline from '../components/Timeline.astro';
import { profile, cv } from '../lib/data';

const bioParagraphs = profile.bio_long.trim().split(/\n\s*\n/);

function startKey(start: string): string {
  // "2024-09" -> 2024-09, "2021" -> 2021-01 (so bare years sort before same-year months)
  return /^\d{4}$/.test(start) ? `${start}-01` : start;
}

const positionItems = cv.positions
  .map((p) => ({
    date: `${p.start} - ${p.end === 'present' ? 'Present' : p.end}`,
    title: p.title,
    org: p.org,
    location: p.location,
    summary: p.summary,
    sortKey: startKey(p.start)
  }))
  .sort((a, b) => b.sortKey.localeCompare(a.sortKey));

const educationItems = cv.education
  .map((e) => ({
    date: `${e.start} - ${e.end}`,
    title: `${e.degree}, ${e.field}`,
    org: e.institution,
    location: e.location,
    summary: e.thesis,
    sortKey: startKey(e.start)
  }))
  .sort((a, b) => b.sortKey.localeCompare(a.sortKey));

const skillLabels: Record<string, string> = {
  programming: 'Programming',
  genetics_tools: 'Genetics tools',
  statistics: 'Statistics',
  data_resources: 'Data resources',
  infrastructure: 'Infrastructure',
  laboratory: 'Laboratory'
};

const skillGroups = Object.entries(cv.skills).map(([key, values]) => ({
  label: skillLabels[key] ?? key,
  values
}));
---

<Base title="About" description={profile.bio_short}>
  <section class="container-x py-20">
    <div class="grid gap-10 lg:grid-cols-[240px_1fr] lg:items-start">
      <img
        src="/photo-1024.jpg"
        width="1024"
        height="1024"
        alt="Sufyan Suleman"
        class="h-[240px] w-[240px] rounded-full object-cover border border-line dark:border-[#233049]"
      />
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-primary dark:text-white sm:text-4xl">{profile.name}</h1>
        <p class="mt-2 text-lg text-muted">{profile.title}</p>
        <p class="text-sm text-muted">{profile.affiliation}</p>
        {profile.affiliation_secondary && <p class="text-sm text-muted">{profile.affiliation_secondary}</p>}
        <p class="mt-1 text-sm text-muted">{profile.location}</p>

        <div class="prose-tight mt-6 space-y-4 text-ink dark:text-[#E5EAF2]">
          {bioParagraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-surface py-20 dark:bg-[#111A2E] dark:border-[#233049]">
    <div class="container-x">
      <SectionHeader eyebrow="Focus" title="Research themes" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {profile.research_themes.map((theme) => (
          <div class="rounded-2xl border border-line bg-white p-6 dark:bg-[#0B1220] dark:border-[#233049]">
            <h3 class="font-semibold text-primary dark:text-white">{theme.name}</h3>
            <p class="mt-2 text-sm text-muted">{theme.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-x py-20">
    <SectionHeader eyebrow="Path" title="Academic journey" />
    <div class="mt-10 grid gap-12 lg:grid-cols-2">
      <div>
        <h3 class="mb-6 text-sm font-semibold uppercase tracking-wide text-muted">Positions</h3>
        <Timeline items={positionItems} />
      </div>
      <div>
        <h3 class="mb-6 text-sm font-semibold uppercase tracking-wide text-muted">Education</h3>
        <Timeline items={educationItems} />
      </div>
    </div>
    <div class="mt-8">
      <ButtonLink href="/about/journey/" variant="secondary" icon="lucide:arrow-right">Read the full story</ButtonLink>
    </div>
  </section>

  <section class="border-t border-line bg-surface py-20 dark:bg-[#111A2E] dark:border-[#233049]">
    <div class="container-x">
      <SectionHeader eyebrow="Toolkit" title="Technical skills" />
      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {skillGroups.map((group) => (
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-muted">{group.label}</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.values.map((v) => <Badge>{v}</Badge>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-x py-20">
    <SectionHeader eyebrow="Communication" title="Languages" />
    <div class="mt-6 flex flex-wrap gap-4">
      {profile.languages.map((l) => (
        <span class="text-sm text-ink dark:text-[#E5EAF2]">
          <strong class="font-semibold text-primary dark:text-white">{l.language}</strong>, {l.level}
        </span>
      ))}
    </div>
  </section>
</Base>
