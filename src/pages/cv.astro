---
import Base from '../layouts/Base.astro';
import ButtonLink from '../components/ButtonLink.astro';
import Badge from '../components/Badge.astro';
import { Icon } from 'astro-icon/components';
import { profile, cv } from '../lib/data';
import { getPublications } from '../lib/publications';

const [emailUser, emailDomain] = profile.socials.email.split('@');

const currentPositions = cv.positions.filter((p) => p.end === 'present');
const pastPositions = cv.positions.filter((p) => p.end !== 'present');

const publications = getPublications();
const pubYears = [...new Set(publications.map((p) => p.year).filter((y): y is number => y != null))].sort(
  (a, b) => b - a
);

const skillLabels: Record<string, string> = {
  programming: 'Programming',
  genetics_tools: 'Genetics tools',
  statistics: 'Statistics',
  data_resources: 'Data resources',
  infrastructure: 'Infrastructure',
  laboratory: 'Laboratory'
};
const skillGroups = Object.entries(cv.skills).map(([key, values]) => ({ label: skillLabels[key] ?? key, values }));

const sections = [
  { id: 'current-position', label: 'Current position' },
  { id: 'education', label: 'Education' },
  { id: 'research-experience', label: 'Research experience' },
  { id: 'publications', label: 'Publications' },
  { id: 'software', label: 'Software' },
  { id: 'teaching', label: 'Teaching' },
  { id: 'consortia', label: 'Consortia' },
  { id: 'awards', label: 'Awards & memberships' },
  { id: 'certifications', label: 'Certifications & training' },
  { id: 'skills', label: 'Skills' },
  { id: 'languages', label: 'Languages' }
];
---

<Base title="CV" description={profile.bio_short}>
  <section class="container-x py-16">
    <div class="flex flex-wrap items-start justify-between gap-6 border-b border-line pb-8 dark:border-[#233049]">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-primary dark:text-white sm:text-4xl">{profile.name}</h1>
        <p class="mt-1 text-lg text-muted">{profile.title}</p>
        <p class="text-sm text-muted">{profile.affiliation}</p>
        {profile.affiliation_secondary && <p class="text-sm text-muted">{profile.affiliation_secondary}</p>}
        <p class="mt-1 text-sm text-muted">{profile.location}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <ButtonLink href="/cv.pdf" icon="lucide:download">Download PDF</ButtonLink>
        <ButtonLink href={profile.socials.orcid} variant="secondary" icon="lucide:badge-check" external>ORCID</ButtonLink>
        <a
          href="#"
          class="js-mailto inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:text-accent-hover"
          data-user={emailUser}
          data-domain={emailDomain}
          data-subject="Hello from your website"
        >
          <Icon name="lucide:mail" class="h-4 w-4" />
          Email
        </a>
      </div>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-[220px_1fr]">
      <nav class="hidden lg:block h-fit lg:sticky lg:top-24">
        <ul class="space-y-2 text-sm">
          {sections.map((s) => (
            <li><a href={`#${s.id}`} class="text-muted hover:text-accent">{s.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="min-w-0 space-y-12 text-sm leading-relaxed">
        <section id="current-position">
          <h2 class="text-xl font-semibold text-primary dark:text-white">Current position</h2>
          <div class="mt-4 space-y-4">
            {currentPositions.map((p) => (
              <div>
                <p class="font-semibold text-ink dark:text-white">{p.title}, {p.org}</p>
                <p class="text-muted">{p.location} · {p.start} - Present</p>
                {p.summary && <p class="mt-1 text-muted">{p.summary}</p>}
                {p.highlights && p.highlights.length > 0 && (
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-muted">
                    {p.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>

        <section id="education">
          <h2 class="text-xl font-semibold text-primary dark:text-white">Education</h2>
          <div class="mt-4 space-y-4">
            {cv.education.map((e) => (
              <div>
                <p class="font-semibold text-ink dark:text-white">{e.degree}, {e.field}</p>
                <p class="text-muted">{e.institution} · {e.location} · {e.start} - {e.end}</p>
                {e.thesis && <p class="mt-1 text-muted">Thesis: {e.thesis}</p>}
                {e.funding && <p class="text-muted">Funding: {e.funding}</p>}
              </div>
            ))}
          </div>
        </section>

        <section id="research-experience">
          <h2 class="text-xl font-semibold text-primary dark:text-white">Research experience</h2>
          <div class="mt-4 space-y-4">
            {pastPositions.map((p) => (
              <div>
                <p class="font-semibold text-ink dark:text-white">{p.title}, {p.org}</p>
                <p class="text-muted">{p.location} · {p.start} - {p.end}</p>
                {p.summary && <p class="mt-1 text-muted">{p.summary}</p>}
                {p.highlights && p.highlights.length > 0 && (
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-muted">
                    {p.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>

        <section id="publications">
          <h2 class="text-xl font-semibold text-primary dark:text-white">Publications</h2>
          <div class="mt-4 space-y-6">
            {pubYears.map((year) => (
              <div>
                <p class="text-sm font-semibold uppercase tracking-wide text-muted">{year}</p>
                <ul class="mt-2 space-y-2">
                  {publications.filter((p) => p.year === year).map((p) => (
                    <li>
                      <span class="text-ink dark:text-white">{p.title}</span>
                      {p.journal &&<span class="text-muted">, {p.journal}</span>}
                      {p.doi && (
                        <a href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener noreferrer" class="ml-2 text-accent hover:text-accent-hover">
                          DOI
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            {cv.manuscripts_in_preparation.length > 0 && (
              <div>
                <p class="text-sm font-semibold uppercase tracking-wide text-muted">Manuscripts in preparation</p>
                <ul class="mt-2 space-y-1">
                  {cv.manuscripts_in_preparation.map((m) => (
                    <li class="text-ink dark:text-white">{m.title} <span class="text-muted">({m.role}, {m.year})</span></li>
                  ))}
                </ul>
              </div>
            )}

            {cv.talks.length > 0 && (
              <div>
                <p class="text-sm font-semibold uppercase tracking-wide text-muted">Talks</p>
                <ul class="mt-2 space-y-1">
                  {cv.talks.map((t) => (
                    <li class="text-ink dark:text-white">{t.title}<span class="text-muted">, {t.venue}, {t.year} ({t.type})</span></li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>

        <section id="software">
          <h2 class="text-xl font-semibold text-primary dark:text-white">Software</h2>
          <ul class="mt-4 space-y-2">
            {cv.software.map((s) => (
              <li>
                <span class="font-semibold text-ink dark:text-white">{s.name}</span>
               <span class="text-muted">, {s.role}{s.platform ? ` · ${s.platform}` : ''}{s.note ? ` · ${s.note}` : ''}</span>
                {s.url && <a href={s.url} target="_blank" rel="noopener noreferrer" class="ml-2 text-accent hover:text-accent-hover">GitHub</a>}
                {s.doi && <a href={`https://doi.org/${s.doi}`} target="_blank" rel="noopener noreferrer" class="ml-2 text-accent hover:text-accent-hover">DOI</a>}
              </li>
            ))}
          </ul>
        </section>

        <section id="teaching">
          <h2 class="text-xl font-semibold text-primary dark:text-white">Teaching</h2>
          <ul class="mt-4 space-y-2">
            {cv.teaching.map((t) => (
              <li>
                <span class="font-semibold text-ink dark:text-white">{t.title}</span>
               <span class="text-muted">, {t.role} · {t.org} · {t.period}</span>
                {t.note && <p class="text-muted">{t.note}</p>}
              </li>
            ))}
          </ul>
          {cv.supervision.length > 0 && (
            <ul class="mt-4 space-y-1">
              {cv.supervision.map((s) => (
                <li class="text-ink dark:text-white">Supervised {s.count} {s.level} students<span class="text-muted">, {s.org}, {s.period}</span></li>
              ))}
            </ul>
          )}
        </section>

        <section id="consortia">
          <h2 class="text-xl font-semibold text-primary dark:text-white">Consortia</h2>
          <ul class="mt-4 space-y-2">
            {cv.consortia.map((c) => (
              <li>
                <span class="font-semibold text-ink dark:text-white">{c.name}</span>
               <span class="text-muted">, {c.role} · {c.period}</span>
                {c.outcome && <p class="text-muted">{c.outcome}</p>}
              </li>
            ))}
          </ul>
        </section>

        <section id="awards">
          <h2 class="text-xl font-semibold text-primary dark:text-white">Awards & memberships</h2>
          <ul class="mt-4 space-y-1">
            {cv.awards.map((a) => (
              <li class="text-ink dark:text-white">{a.title}<span class="text-muted">, {a.org}, {a.period}</span></li>
            ))}
            {cv.memberships.map((m) => (
              <li class="text-ink dark:text-white">{m.name}<span class="text-muted">, since {m.since}</span></li>
            ))}
          </ul>
        </section>

        <section id="certifications">
          <h2 class="text-xl font-semibold text-primary dark:text-white">Certifications & training</h2>
          <ul class="mt-4 space-y-1">
            {cv.certifications.map((c) => (
              <li class="text-ink dark:text-white">{c.name}<span class="text-muted">, {c.issuer}{c.year ? `, ${c.year}` : ''}</span></li>
            ))}
            {cv.training.map((t) => (
              <li class="text-ink dark:text-white">{t.name}<span class="text-muted">, {t.org}, {t.year}</span></li>
            ))}
          </ul>
        </section>

        <section id="skills">
          <h2 class="text-xl font-semibold text-primary dark:text-white">Skills</h2>
          <div class="mt-4 space-y-4">
            {skillGroups.map((g) => (
              <div>
                <p class="text-sm font-semibold text-ink dark:text-white">{g.label}</p>
                <div class="mt-2 flex flex-wrap gap-2">
                  {g.values.map((v) => <Badge>{v}</Badge>)}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section id="languages">
          <h2 class="text-xl font-semibold text-primary dark:text-white">Languages</h2>
          <div class="mt-4 flex flex-wrap gap-4">
            {cv.languages.map((l) => (
              <span class="text-ink dark:text-white"><strong class="font-semibold">{l.language}</strong>, {l.level}</span>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>
</Base>
