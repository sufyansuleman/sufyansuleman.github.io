---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Badge from '../components/Badge.astro';
import MailLine from '../components/MailLine.astro';
import { projects } from '../lib/data';
import { getItem } from '../lib/catalog';
import { getPublications } from '../lib/publications';

const publications = getPublications();
const pubByDoi = new Map(publications.filter((p) => p.doi).map((p) => [p.doi!.toLowerCase(), p]));

const statusLabels: Record<string, string> = {
  active: 'Active',
  'in-preparation': 'In preparation',
  completed: 'Completed'
};

function periodLabel(period: { start: string; end?: string }): string {
  return period.end ? `${period.start} - ${period.end}` : `${period.start} - present`;
}

function resolveLinks(project: (typeof projects)[number]) {
  const toolLinks = project.related.tools
    .map((name) => getItem(name))
    .filter((item): item is NonNullable<typeof item> => Boolean(item))
    .map((item) => ({ label: item.title, href: `/tools/${item.urlSlug}/` }));

  const courseLinks = project.related.courses
    .map((slug) => getItem(slug))
    .filter((item): item is NonNullable<typeof item> => Boolean(item))
    .map((item) => ({ label: item.title, href: `/courses/${item.urlSlug}/` }));

  const pubLinks = project.related.publications.map((doi) => {
    const pub = pubByDoi.get(doi.toLowerCase());
    return { label: pub?.title ?? doi, href: `https://doi.org/${doi}` };
  });

  return [...toolLinks, ...courseLinks, ...pubLinks];
}
---

<Base title="Projects">
  <section class="container-x py-20">
    <SectionHeader
      title="Projects"
      lede="Research projects from Oulu, Copenhagen and Aarhus."
    />

    <div class="mt-10 grid gap-6 sm:grid-cols-2" id="project-grid">
      {projects.map((project) => {
        const links = resolveLinks(project);
        const visibleMethods = project.methods.slice(0, 6);
        const extraMethods = project.methods.length - visibleMethods.length;
        const visibleOutcomes = project.outcomes.slice(0, 3);
        return (
          <div
            class="project-card flex flex-col gap-4 rounded-2xl border border-line bg-white p-6 dark:bg-[#111A2E] dark:border-[#233049]"
            data-status={project.status}
          >
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-lg font-semibold text-primary dark:text-white">{project.title}</h3>
              <Badge variant={project.status === 'active' ? 'accent' : 'neutral'}>{statusLabels[project.status]}</Badge>
            </div>
            <p class="text-xs font-medium uppercase tracking-wide text-muted">{periodLabel(project.period)}</p>
            <p class="text-sm text-muted">{project.summary}</p>
            <p class="text-sm text-ink dark:text-[#E5EAF2]"><strong class="font-medium">Role:</strong> {project.role}</p>

            {visibleMethods.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {visibleMethods.map((m) => <Badge>{m}</Badge>)}
                {extraMethods > 0 && <Badge>+{extraMethods}</Badge>}
              </div>
            )}

            {visibleOutcomes.length > 0 && (
              <ul class="list-disc space-y-1 pl-5 text-sm text-muted">
                {visibleOutcomes.map((o) => <li>{o}</li>)}
              </ul>
            )}

            {links.length > 0 && (
              <div class="flex flex-wrap gap-x-4 gap-y-1 pt-1">
                {links.map((l) => (
                  <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="text-sm text-accent hover:text-accent-hover">
                    {l.label}
                  </a>
                ))}
              </div>
            )}

            {project.milestones && project.milestones.length > 0 && (
              <div class="mt-2 flex flex-wrap gap-x-6 gap-y-1 border-t border-line pt-3 text-xs text-muted dark:border-[#233049]">
                {project.milestones.map((m) => (
                  <span>{m.date} · {m.label}</span>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </div>

    <div class="mt-10">
      <MailLine text="Interested in any of these projects?" subject="Project enquiry" />
    </div>
  </section>
</Base>
