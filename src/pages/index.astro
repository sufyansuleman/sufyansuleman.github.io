---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ButtonLink from '../components/ButtonLink.astro';
import Badge from '../components/Badge.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CardGrid from '../components/CardGrid.astro';
import Card from '../components/Card.astro';
import Cover from '../components/Cover.astro';
import PubItem from '../components/PubItem.astro';
import VisitorCount from '../components/VisitorCount.astro';
import WorkWithMe from '../components/WorkWithMe.astro';
import { profile } from '../lib/data';
import { featured as getFeatured } from '../lib/catalog';
import { latest } from '../lib/publications';

const featured = getFeatured()
  .filter((item) => item.categories.includes('tool'))
  .slice(0, 3);

const latestPubs = latest(3);

---

<Base title="Home">
  <Hero headline={profile.name} kicker={profile.kicker} paragraphs={profile.hero_paragraphs}>
    <Fragment slot="actions">
      <ButtonLink href="/tools/">Tools</ButtonLink>
      <ButtonLink href="/publications/" variant="secondary">Publications</ButtonLink>
      <ButtonLink href="/courses/" variant="secondary">Courses</ButtonLink>
      <ButtonLink href="/about/" variant="secondary">About</ButtonLink>
    </Fragment>

    <Fragment slot="aside">
      <div class="mx-auto max-w-xs rounded-3xl border border-line bg-white p-5 text-center shadow-sm dark:bg-[#111A2E] dark:border-[#233049]">
        <img src="/photo-512.jpg" width="512" height="512" alt="Sufyan Suleman" class="mx-auto h-32 w-32 rounded-full object-cover" />
        <p class="mt-4 font-semibold text-primary dark:text-white">{profile.title}</p>
        <p class="text-xs text-muted">{profile.affiliation}</p>
        {profile.affiliation_secondary && <p class="text-xs text-muted">{profile.affiliation_secondary}</p>}
        <div class="mt-4 flex flex-wrap justify-center gap-2">
          {profile.interests.slice(0, 5).map((interest) => <Badge>{interest}</Badge>)}
        </div>
      </div>
    </Fragment>
  </Hero>

  <section class="container-x pt-8 pb-16">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="text-sm font-medium uppercase tracking-wide text-accent">{profile.statement_eyebrow}</p>
        {profile.statement_paragraphs.map((t) => <p class="mt-5 text-lg leading-relaxed text-ink dark:text-[#E5EAF2]">{t}</p>)}
      </div>
      <aside class="lg:col-span-4 lg:pt-10">
        <div class="lg:sticky lg:top-28">
          <p class="hidden border-l-2 border-accent pl-6 text-xl font-medium leading-snug text-primary lg:block dark:text-white">{profile.statement_aside}</p>
          <p class="text-sm font-medium uppercase tracking-wide text-accent lg:mt-10">{profile.values_title}</p>
          <ul class="mt-4 space-y-3">
            {profile.values.map((v) => (
              <li class="flex gap-3 text-base text-ink dark:text-[#E5EAF2]">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
                <span>{v}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="container-x py-20">
    <SectionHeader
      eyebrow="Tools"
      title="R packages"
      lede="Written because I needed them, then released so others could use them."
    />
    <div class="mt-10">
      <CardGrid>
        {featured.map((item) => (
          <Card title={item.title} description={item.tagline} href={`/tools/${item.urlSlug}/`} icon={item.icon}>
            <Cover item={item} slot="cover" />
          </Card>
        ))}
      </CardGrid>
    </div>
  </section>

  <section class="container-x py-20">
    <SectionHeader
      eyebrow="Research output"
      title="Latest publications"
      lede="Recent peer-reviewed work."
    />
    <ul class="mt-10">
      {latestPubs.map((pub) => <PubItem pub={pub} compact />)}
    </ul>
    <div class="mt-6">
      <ButtonLink href="/publications/" variant="ghost">All publications</ButtonLink>
    </div>
  </section>

  <section class="container-x py-20">
    <WorkWithMe />
  </section>

  <VisitorCount />
</Base>
