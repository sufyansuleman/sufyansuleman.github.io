---
import Article from '../../layouts/Article.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'journey');
if (!entry) throw new Error('journey.mdx entry not found in pages collection');
const { Content, headings } = await render(entry);

const updated = entry.data.updated
  ? new Date(`${entry.data.updated}-01`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })
  : undefined;
---

<Article
  title={entry.data.title}
  summary={entry.data.summary}
  updated={updated}
  crumbs={[{ label: 'About', href: '/about/' }, { label: 'Academic journey' }]}
  headings={headings}
  mailText="If any of this overlaps with your work, I would like to hear from you."
  mailSubject="Hello from your website"
>
  <Content />
</Article>
