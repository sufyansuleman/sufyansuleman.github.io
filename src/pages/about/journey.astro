---
import Base from '../../layouts/Base.astro';
import MailLine from '../../components/MailLine.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'journey');
if (!entry) throw new Error('journey.mdx entry not found in pages collection');
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

const updated = entry.data.updated
  ? new Date(`${entry.data.updated}-01`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })
  : undefined;
---

<Base title="Academic journey" description={entry.data.summary}>
  <section class="container-x py-20">
    <nav class="text-sm text-muted">
      <a href="/about/" class="hover:text-accent">About</a>
      <span class="mx-2">/</span>
      <span class="text-ink dark:text-white">Academic journey</span>
    </nav>

    <div class="mt-6 max-w-3xl">
      <h1 class="text-3xl font-semibold tracking-tight text-primary dark:text-white sm:text-4xl">{entry.data.title}</h1>
      {entry.data.summary && <p class="mt-4 text-lg text-muted">{entry.data.summary}</p>}
      {updated && <p class="mt-2 text-sm text-muted">Updated {updated}</p>}
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_240px]">
      <div class="min-w-0 prose prose-slate dark:prose-invert max-w-none break-words prose-headings:text-primary dark:prose-headings:text-white prose-h2:mt-10 prose-h2:text-xl prose-h3:mt-6 prose-a:text-accent prose-table:text-sm [&_table]:block [&_table]:overflow-x-auto">
        <Content />
      </div>

      {toc.length > 0 && (
        <aside class="hidden lg:block h-fit lg:sticky lg:top-24">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted">On this page</p>
          <ul class="mt-3 space-y-2 text-sm">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-ink hover:text-accent dark:text-[#E5EAF2]">{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <div class="mt-10 max-w-3xl">
      <MailLine text="If any of this overlaps with your work, I would like to hear from you." subject="Hello from your website" />
    </div>
  </section>
</Base>
