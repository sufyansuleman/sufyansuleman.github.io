---
import Base from './Base.astro';
import MailLine from '../components/MailLine.astro';
import type { MarkdownHeading } from 'astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  summary?: string;
  updated?: string;
  crumbs: Crumb[];
  headings: MarkdownHeading[];
  mailText: string;
  mailSubject: string;
  statusLabel?: string;
}

const { title, summary, updated, crumbs, headings, mailText, mailSubject, statusLabel } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={summary}>
  <section class="container-x py-20">
    <nav class="text-sm text-muted">
      {crumbs.map((crumb, i) => (
        <>
          {crumb.href ? (
            <a href={crumb.href} class="hover:text-accent">{crumb.label}</a>
          ) : (
            <span class="text-ink dark:text-white">{crumb.label}</span>
          )}
          {i < crumbs.length - 1 && <span class="mx-2">/</span>}
        </>
      ))}
    </nav>

    <div class="mt-6 max-w-3xl">
      <h1 class="text-3xl font-semibold tracking-tight text-primary dark:text-white sm:text-4xl">{title}</h1>
      {summary && <p class="mt-4 text-lg text-muted">{summary}</p>}
      {(updated || statusLabel) && (
        <p class="mt-2 text-sm text-muted">
          {statusLabel && <span class="mr-2 inline-flex items-center rounded-full border border-line px-2 py-0.5 text-xs font-medium text-ink dark:border-[#233049] dark:text-[#E5EAF2]">{statusLabel}</span>}
          {updated && <>Updated {updated}</>}
        </p>
      )}
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_240px]">
      <div class="min-w-0 prose prose-slate dark:prose-invert max-w-none break-words prose-headings:text-primary dark:prose-headings:text-white prose-h2:mt-10 prose-h2:text-xl prose-h3:mt-6 prose-a:text-accent prose-table:text-sm [&_table]:block [&_table]:overflow-x-auto">
        <slot />
      </div>

      {toc.length > 0 && (
        <aside class="hidden lg:block h-fit lg:sticky lg:top-24">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted">On this page</p>
          <ul class="mt-3 space-y-2 text-sm">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-ink hover:text-accent dark:text-[#E5EAF2]">{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <div class="mt-10 max-w-3xl">
      <MailLine text={mailText} subject={mailSubject} />
    </div>
  </section>
</Base>
